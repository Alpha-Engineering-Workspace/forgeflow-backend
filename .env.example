# Development-only example. Copy to .env, which is gitignored.
NODE_ENV=development
HOST=127.0.0.1
GATEWAY_PORT=3001
AUTH_PORT=3002
CORE_PORT=3003

# Docker exposes Postgres/Redis only on the Windows host loopback.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=forgeflow_dev
REDIS_URL=redis://127.0.0.1:6380

# Generate FOUR DIFFERENT random strings for these values.
# Never commit .env or reuse these passwords outside local development.
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
AUTH_DB_PASSWORD=
CORE_DB_PASSWORD=

# M6 invitation delivery. Set verified sender/domain and https://your-frontend-domain.
# For local development, http://localhost:3000 is permitted.
WORKSPACE_INVITE_EMAIL_MODE=resend
WORKSPACE_INVITE_BASE_URL=http://localhost:3000
# Reuse AUTH_EMAIL_FROM and RESEND_API_KEY in Compose (Core receives private values).
